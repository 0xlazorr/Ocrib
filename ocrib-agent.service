[Unit]
Description=Ocrib Remote Download Agent
After=network.target
Documentation=https://github.com/lazorr/Ocrib

[Service]
Type=simple
User=ocrib
Group=ocrib
EnvironmentFile=-/etc/default/ocrib-agent
ExecStart=/usr/bin/remote_agent $OCRIB_SERVER $OCRIB_PORT
Restart=always
RestartSec=5
StateDirectory=ocrib
WorkingDirectory=/var/lib/ocrib

[Install]
WantedBy=multi-user.target
